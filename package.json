{
  "name": "car-flipper-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Car Flipper Tycoon: browse, inspect, negotiate, repair and resell used cars.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate-economy.ts",
    "verify:images": "tsx scripts/verify-images.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "verify:release": "npm run verify && npm run verify:images"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
